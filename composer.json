{
    "name": "silvercommerce/discounts",
    "description": "Module that adds discounts (either as a code, or on a group) to SilverCommerce",
      "type": "silverstripe-vendormodule",
      "homepage": "http://github.com/silvercommerce/discounts",
      "keywords": [
          "silverstripe",
          "silvercommerce",
          "commerce",
          "ecommerce",
          "discounts",
          "discount codes"
      ],
      "license": "BSD-3-Clause",
      "authors": [
          {
              "name": "Dean Forest Tech",
              "homepage": "https://dean-forest-tech.uk"
          }
      ],
      "support": {
          "issues": "http://github.com/silvercommerce/discounts/issues"
      },
      "require": {
          "silverstripe/framework": "^4 || ^5",
          "silvercommerce/settings": "^1",
          "silvercommerce/orders-admin": "^1",
          "symbiote/silverstripe-gridfieldextensions": "^3 || ^4"
      },
      "require-dev": {
          "silvercommerce/catalogue-admin": "^1",
          "phpunit/phpunit": "^9.2",
          "squizlabs/php_codesniffer": "^3"
      },
      "autoload": {
          "psr-4": {
              "SilverCommerce\\Discounts\\": "src/",
              "SilverCommerce\\Discounts\\Tests\\": "tests/"
          }
      },
      "scripts": {
          "lint": "vendor/bin/phpcs src/ tests/",
          "lint-clean": "vendor/bin/phpcbf src/ tests/"
      },
      "minimum-stability": "dev",
      "prefer-stable": true
  }
  